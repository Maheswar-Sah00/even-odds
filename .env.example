# ---------------------------------------------------------------------------
# Even Odds - PUBLIC browser configuration (copy to .env.local)
#
# Every variable here is embedded in the browser bundle by Vite (VITE_ prefix).
# They identify the Appwrite project; they are NOT secrets. Never put an API key
# or any server secret in a VITE_ variable. Server-only values belong in
# .env.server (see .env.server.example).
# ---------------------------------------------------------------------------

# Appwrite API endpoint, including the /v1 suffix.
# Appwrite Cloud example: https://fra.cloud.appwrite.io/v1 (use your region).
VITE_APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1

# Project ID from Appwrite Console > Project settings.
VITE_APPWRITE_PROJECT_ID=<project-id>

# The single TablesDB database that holds every Even Odds table.
VITE_APPWRITE_DATABASE_ID=even-odds

# Optional: Team whose members are organisers (Appwrite Console > Auth > Teams).
# Leave empty until organiser features are set up.
VITE_APPWRITE_ORGANISER_TEAM_ID=

# Optional table ID overrides. Each defaults to the canonical ID shown, which
# is what `npm run db:provision` creates. Only set these if you provisioned
# tables under different IDs.
# VITE_APPWRITE_TABLE_PROGRAMS=programs
# VITE_APPWRITE_TABLE_SEAT_LEDGER=seat_ledger
# VITE_APPWRITE_TABLE_ZONES=zones
# VITE_APPWRITE_TABLE_FAMILIES=families
# VITE_APPWRITE_TABLE_FAMILY_LOCATIONS=family_locations
# VITE_APPWRITE_TABLE_GUARDIANS=guardians
# VITE_APPWRITE_TABLE_CHILDREN=children
# VITE_APPWRITE_TABLE_PREFERENCES=preferences
# VITE_APPWRITE_TABLE_PLACEMENTS=placements
# VITE_APPWRITE_TABLE_WAITLIST=waitlist
# VITE_APPWRITE_TABLE_OVERRIDES=overrides
# VITE_APPWRITE_TABLE_DRAW_RUNS=draw_runs
# VITE_APPWRITE_TABLE_AUDIT_LOG=audit_log
# VITE_APPWRITE_TABLE_IDEMPOTENCY=idempotency

# Set to "true" to log Appwrite request summaries (operation, duration,
# outcome; never payloads) to the browser console in production builds.
# Development builds always log.
VITE_LOG_REQUESTS=false
