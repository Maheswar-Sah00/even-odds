# ---------------------------------------------------------------------------
# Even Odds - SERVER-ONLY configuration (copy to .env.server; never commit it)
#
# Read by scripts/ (provisioning, diagnostics, integration tests) and by
# Appwrite Functions via their own environment variables. Vite never loads this
# file, and src/ cannot import the modules that read it (enforced by ESLint and
# by a bundle-scan test).
# ---------------------------------------------------------------------------

APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<project-id>
APPWRITE_DATABASE_ID=even-odds

# Server API key (Console > Overview > Integrations > API keys).
# Required scopes: databases.read, databases.write, tables.read, tables.write,
# columns.read, columns.write, indexes.read, indexes.write, rows.read,
# rows.write, users.read, users.write, sessions.write, teams.read, teams.write.
APPWRITE_API_KEY=<server-api-key>

# Secret used to derive child_key = HMAC-SHA256(secret, normalised identity).
# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it changes every child_key, so set it once per program.
CHILD_KEY_SECRET=<64-hex-chars>

# Organiser team ID (same value as VITE_APPWRITE_ORGANISER_TEAM_ID).
APPWRITE_ORGANISER_TEAM_ID=
