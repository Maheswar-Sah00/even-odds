{
  "name": "even-odds",
  "private": true,
  "version": "0.1.0",
  "description": "Verifiable lottery for oversubscribed community programs, built on Appwrite TablesDB.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:integration": "vitest run --project integration",
    "test:stress": "vitest run --project stress",
    "db:provision": "tsx scripts/db-provision.ts",
    "db:check": "tsx scripts/db-provision.ts --check",
    "diagnose": "tsx scripts/diagnose.ts",
    "docs:schema": "tsx scripts/gen-schema-doc.ts",
    "functions:build": "tsx scripts/build-functions.ts",
    "functions:deploy": "tsx scripts/deploy-functions.ts",
    "db:migrate:001": "tsx scripts/migrations/001-households.ts",
    "db:migrate:002": "tsx scripts/migrations/002-offer-cancelled.ts",
    "db:migrate:003": "tsx scripts/migrations/003-ticket-permissions.ts",
    "setup:organisers": "tsx scripts/setup-organisers.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "odds:run": "tsx scripts/run-odds.ts",
    "seed:applicants": "tsx scripts/seed-demo-applicants.ts",
    "smoke:demo": "tsx scripts/smoke-demo.ts",
    "brand:render": "tsx scripts/render-brand-assets.ts"
  },
  "dependencies": {
    "appwrite": "^29.1.0",
    "drand-client": "^1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "node-appwrite": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
